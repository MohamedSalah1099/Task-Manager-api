# .env.example
# Copy this file to .env and fill in your real values.
# NEVER commit .env to Git - it is already in .gitignore.
# This file IS committed to Git as a reference for other developers.

# ── Database ──────────────────────────────────────────────────────────────────
DB_URL=jdbc:postgresql://localhost:5432/task_manager_db
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here

# ── JWT Secrets ───────────────────────────────────────────────────────────────
# Generate a secure random secret: openssl rand -base64 64
JWT_SECRET=replace_with_a_long_random_secret_minimum_64_characters_for_HS256_algorithm
JWT_ACCESS_TOKEN_EXPIRATION=900000
JWT_REFRESH_TOKEN_EXPIRATION=604800000